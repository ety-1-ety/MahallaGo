# ─────────────────────────────────────────────────────────────────
# Buyer Bot — @MahallaGoBot
# ─────────────────────────────────────────────────────────────────

# Telegram bot token (получить у @BotFather)
BOT_TOKEN=

# Подключение к PostgreSQL (на VPS#1, порт через приватную сеть cloud)
# Локально: postgresql://postgres:CHANGE_ME@localhost:5432/mahallago_dev
DATABASE_URL=

# Подключение к Redis (на VPS#1)
# Локально: redis://localhost:6379/1
REDIS_URL=

# Префикс ключей сессий и rate-limit в Redis (изоляция от seller-bot)
REDIS_PREFIX=buyer:

# Канал Redis pub/sub для уведомлений покупателю об изменении статуса
# заказа (publish'ит seller-bot после orders.update_status)
REDIS_CHANNEL_ORDER_STATUS=orders:status

# Окружение: development | production
NODE_ENV=development

# Уровень логов pino: debug | info | warn | error
LOG_LEVEL=info

# Часовой пояс отображения (для расчётов рабочих часов магазинов)
TZ=Asia/Tashkent

# Rate limit: максимум запросов в секунду на одного пользователя
RATE_LIMIT_PER_SEC=10
