# ─────────────────────────────────────────────────────────────────
# Admin API — Fastify backend для админ-панели
# ─────────────────────────────────────────────────────────────────

# Порт прослушивания (Nginx проксирует api.mahallashop.uz → localhost:3000)
PORT=3000
HOST=127.0.0.1

# Подключение к PostgreSQL
# Локально: postgresql://postgres:CHANGE_ME@localhost:5432/mahallashop_dev
DATABASE_URL=

# Подключение к Redis (для pub/sub уведомлений ботам)
# Локально: redis://localhost:6379/1
REDIS_URL=

# Каналы Redis pub/sub (должны совпадать с настройками ботов)
REDIS_CHANNEL_NEW_ORDER=orders:new
REDIS_CHANNEL_MODERATION=shops:moderation

# Telegram bot token (для проверки auth-данных Telegram Login Widget
# и вызова getFile API при показе фото в админке)
# Используется токен buyer-бота, на который настроен Login Widget
BOT_TOKEN=

# Имя бота, на который настроен Telegram Login Widget (без @)
BOT_USERNAME=MahallaShop_bot

# Whitelist Telegram ID для первичных админов (через запятую).
# В дополнение к auth.users.is_admin = true в БД.
ADMIN_TG_IDS=

# JWT секрет для подписи токенов админ-сессий (32+ случайных байта)
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Cookie с JWT
COOKIE_NAME=mhs_admin
COOKIE_DOMAIN=
COOKIE_SECURE=false

# CORS origin для admin-web (например, https://shop.mahallashop.uz)
# Локально: http://localhost:4200
CORS_ORIGIN=http://localhost:4200

# Окружение: development | production
NODE_ENV=development

# Уровень логов pino
LOG_LEVEL=info

# Часовой пояс
TZ=Asia/Tashkent
