# ─────────────────────────────────────────────────────────────────
# Seller Bot — @MahallaShop_seller_bot
# ─────────────────────────────────────────────────────────────────

# Telegram bot token (получить у @BotFather)
BOT_TOKEN=

# Подключение к PostgreSQL
# Локально: postgresql://postgres:CHANGE_ME@localhost:5432/mahallashop_dev
DATABASE_URL=

# Подключение к Redis
# Локально: redis://localhost:6379/1
REDIS_URL=

# Префикс ключей сессий и rate-limit в Redis
REDIS_PREFIX=seller:

# Канал Redis pub/sub для уведомлений о новых заказах
REDIS_CHANNEL_NEW_ORDER=orders:new

# Канал Redis pub/sub для уведомлений о модерации (одобрено/отклонено)
REDIS_CHANNEL_MODERATION=shops:moderation

# Канал Redis pub/sub для уведомлений покупателю об изменении статуса
# заказа (seller-bot publish'ит после orders.update_status)
REDIS_CHANNEL_ORDER_STATUS=orders:status

# Окружение: development | production
NODE_ENV=development

# Уровень логов pino
LOG_LEVEL=info

# Часовой пояс
TZ=Asia/Tashkent

# Rate limit
RATE_LIMIT_PER_SEC=10
