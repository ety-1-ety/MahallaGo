{
  "name": "mahallago",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hyperlocal маркетплейс магазинов в Telegram для Узбекистана",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "refresh-functions": "node scripts/refresh-functions.js",
    "dev:buyer-bot": "pnpm --filter @mahallago/buyer-bot dev",
    "dev:seller-bot": "pnpm --filter @mahallago/seller-bot dev",
    "dev:admin-api": "pnpm --filter @mahallago/admin-api dev",
    "dev:admin-web": "pnpm --filter @mahallago/admin-web start",
    "dev:buyer-web": "pnpm --filter @mahallago/buyer-web start",
    "dev:seller-web": "pnpm --filter @mahallago/seller-web start",
    "start:buyer-bot": "pnpm --filter @mahallago/buyer-bot start",
    "start:seller-bot": "pnpm --filter @mahallago/seller-bot start",
    "start:admin-api": "pnpm --filter @mahallago/admin-api start",
    "build:admin-web": "pnpm --filter @mahallago/admin-web build",
    "build:buyer-web": "pnpm --filter @mahallago/buyer-web build",
    "build:seller-web": "pnpm --filter @mahallago/seller-web build"
  },
  "dependencies": {
    "dotenv": "16",
    "pg": "8"
  }
}
